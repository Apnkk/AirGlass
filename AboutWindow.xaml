<Window x:Class="AirGlass.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AirGlass.Services"
        Title="À propos d'AirGlass"
        Width="520" Height="520"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        svc:GlassBackdrop.Enabled="True"
        Background="{StaticResource WindowSolidBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid Margin="28,26,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="AirGlass" FontFamily="{StaticResource UiDisplayFont}"
                 FontSize="26" FontWeight="SemiBold" />
      <TextBlock x:Name="VersionText" FontSize="12"
                 Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="20"
            Padding="20,18" Margin="0,18,0,18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20">
            <Run Text="Le moteur de réception AirPlay est " />
            <Run Text="UxPlay" FontWeight="SemiBold" />
            <Run Text=", un logiciel libre distribué sous licence GPLv3. AirGlass le lance comme programme séparé." />
          </TextBlock>

          <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0">
            <Run Text="Code source d'UxPlay : " />
            <Hyperlink NavigateUri="https://github.com/FDH2/UxPlay"
                       RequestNavigate="OnLinkNavigate">github.com/FDH2/UxPlay</Hyperlink>
          </TextBlock>

          <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"
                     Text="Les bibliothèques GStreamer et FFmpeg fournies avec l'application restent sous leurs licences respectives (LGPL/GPL)." />

          <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"
                     Foreground="{StaticResource MutedBrush}"
                     Text="AirPlay, iPhone et iOS sont des marques d'Apple Inc. AirGlass n'est ni affilié, ni approuvé, ni sponsorisé par Apple." />

          <Button x:Name="NoticesButton" Style="{StaticResource GhostButton}"
                  Content="Ouvrir les licences" Padding="16,8" FontSize="13" Margin="0,18,0,0"
                  HorizontalAlignment="Left" Click="OnOpenNotices" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Button Grid.Row="0" Style="{StaticResource TrafficLightButton}" Background="#FF5F57" Tag="×"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0"
            ToolTip="Fermer" AutomationProperties.Name="Fermer" IsCancel="True"
            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
  </Grid>
</Window>
