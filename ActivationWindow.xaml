<Window x:Class="AirGlass.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AirGlass.Services"
        Title="Activer AirGlass"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        svc:GlassBackdrop.Enabled="True"
        Background="{StaticResource WindowSolidBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="0"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
  <StackPanel Margin="28,26,28,24">
    <TextBlock Text="Activer ta licence" FontFamily="{StaticResource UiDisplayFont}"
               FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Colle la clé reçue après ton achat. Elle commence par AS1-."
               FontSize="13" Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" Margin="0,6,0,18" />

    <TextBox x:Name="KeyBox"
             Height="104" TextWrapping="Wrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             FontSize="13" FontFamily="Consolas" />

    <TextBlock x:Name="ErrorText" Visibility="Collapsed"
               Foreground="{StaticResource DangerBrush}"
               FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="BuyButton" Style="{StaticResource GhostButton}"
              Content="Acheter" Padding="18,8" FontSize="13" Margin="0,0,8,0"
              Visibility="Collapsed" Click="OnBuy" />
      <Button Style="{StaticResource GhostButton}" Content="Plus tard"
              Padding="18,8" FontSize="13" Margin="0,0,8,0" IsCancel="True" />
      <Button Style="{StaticResource ModernButton}" Content="Activer"
              Padding="22,8" FontSize="13" IsDefault="True" Click="OnActivate" />
    </StackPanel>
  </StackPanel>
  <Button Style="{StaticResource TrafficLightButton}" Background="#FF5F57" Tag="×"
          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
          ToolTip="Fermer" AutomationProperties.Name="Fermer"
          WindowChrome.IsHitTestVisibleInChrome="True" Click="OnTitleClose" />
  </Grid>
</Window>
