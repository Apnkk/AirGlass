<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AirGlass</AssemblyName>
    <RootNamespace>AirGlass</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AirGlass.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <Product>AirGlass</Product>
    <!-- DPI is declared in app.manifest (WPF app, WinForms only used for the tray icon) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; avoid name clashes with WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Vendor tools (license key generator) are not part of the app -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <!-- Protection SDK, promo video project and bundled binaries are not part of the app -->
    <Compile Remove="protection\**" />
    <None Remove="protection\**" />
    <EmbeddedResource Remove="protection\**" />
    <Page Remove="protection\**" />
    <Compile Remove="promo\**" />
    <None Remove="promo\**" />
    <Compile Remove="external\**" />
    <None Remove="external\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="AirGlass.ico" />
  </ItemGroup>

</Project>
