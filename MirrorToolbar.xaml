<Window x:Class="AirGlass.MirrorToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight">
  <Window.Resources>
    <Style x:Key="ToolIconButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="8" Background="Transparent" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#14FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="12" CornerRadius="12" Background="#E6121419"
          BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="#000000" />
    </Border.Effect>
    <StackPanel Orientation="Horizontal" Margin="4">
      <Button x:Name="FullscreenButton" Style="{StaticResource ToolIconButton}"
              ToolTip="Plein écran (F11)" AutomationProperties.Name="Plein écran"
              Click="OnFullscreenClick">
        <TextBlock x:Name="FullscreenGlyph" Text="&#xE740;" FontFamily="{StaticResource IconFont}"
                   FontSize="16" />
      </Button>
      <Button x:Name="CaptureButton" Style="{StaticResource ToolIconButton}"
              ToolTip="Capture d'écran (F12)" AutomationProperties.Name="Capture d'écran"
              Click="OnCaptureClick">
        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="16" />
      </Button>
      <Button x:Name="QualityButton" Style="{StaticResource ToolIconButton}" Width="Auto" MinWidth="36"
              ToolTip="Qualité" AutomationProperties.Name="Qualité"
              Click="OnQualityClick">
        <TextBlock x:Name="QualityLabel" Margin="8,0" FontFamily="{StaticResource UiFont}"
                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
      </Button>
      <TextBlock x:Name="HintText" Visibility="Collapsed" VerticalAlignment="Center"
                 Margin="6,0,12,0" FontFamily="{StaticResource UiFont}" FontSize="12"
                 Foreground="{StaticResource MutedBrush}" />
    </StackPanel>
  </Border>
</Window>