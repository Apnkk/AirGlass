<Window x:Class="AirGlass.ModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AirGlass.Services"
        Title="AirGlass"
        Icon="{StaticResource LogoImage}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        svc:GlassBackdrop.Enabled="True"
        UseLayoutRounding="True"
        Background="{StaticResource WindowSolidBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="0"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <StackPanel Margin="28,26,28,28">
      <TextBlock Text="Quel téléphone veux-tu afficher ?"
                 Margin="0,0,32,0"
                 FontFamily="{StaticResource UiDisplayFont}"
                 FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Margin="0,8,0,24" FontSize="13" TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}"
                 Text="Apple : AirPlay, sans fil. Android : câble USB (ou Wi-Fi) avec le débogage USB activé." />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="AppleButton" Grid.Column="0" Style="{StaticResource ModernButton}"
                Height="48" IsDefault="True"
                AutomationProperties.Name="Apple" Click="OnAppleClick">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Viewbox Width="20" Height="20" Margin="0,0,10,0">
              <Grid Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
              </Grid>
            </Viewbox>
            <TextBlock Text="Apple" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="AndroidButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                Height="48"
                AutomationProperties.Name="Android" Click="OnAndroidClick">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Viewbox Width="20" Height="20" Margin="0,0,10,0">
              <Grid Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="0.01"
                      Data="M6,9 A6,6 0 0 1 18,9 Z M8.7,6 A0.8,0.8 0 1 0 10.3,6 A0.8,0.8 0 1 0 8.7,6 Z M13.7,6 A0.8,0.8 0 1 0 15.3,6 A0.8,0.8 0 1 0 13.7,6 Z M6,10 H18 V17 A1,1 0 0 1 17,18 H7 A1,1 0 0 1 6,17 Z M8,18 H10 V21 H8 Z M14,18 H16 V21 H14 Z M3,10 H5 V16 H3 Z M19,10 H21 V16 H19 Z" />
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M8,3 L9.2,5 M16,3 L14.8,5" />
              </Grid>
            </Viewbox>
            <TextBlock Text="Android" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <CheckBox x:Name="RememberBox" Margin="0,24,0,0" Content="Mémoriser mon choix"
                AutomationProperties.Name="Mémoriser mon choix" />
    </StackPanel>

    <Button Style="{StaticResource TrafficLightButton}" Background="#FF5F57" Tag="×"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
            ToolTip="Fermer" AutomationProperties.Name="Fermer"
            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnTitleClose" />
  </Grid>
</Window>